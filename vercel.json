{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ecole-monseigneur-bernard-bududira.onrender.com/api/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/pages/inscription.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
